# Docker-network overrides for the docker compose stack.
#
# This file is merged after `.env` (later env_file entries win), so services
# running inside the compose network talk to each other by service name instead
# of localhost. It contains no secrets and is safe to commit.
DATABASE_HOST=postgres
DATABASE_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379

S3_ENDPOINT=http://minio:9000

LLM_BASE_URL=http://llama-server:8081/v1
