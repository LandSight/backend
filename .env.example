# ── Logging ──────────────────────────────────────────────────────────
LOGGING_LEVEL=INFO
LOGGING_FORMATTER=pretty

# ── Application ──────────────────────────────────────────────────────
APP_HOST=127.0.0.1
APP_PORT=8000
DOCS_HOST=127.0.0.1
DOCS_PORT=8008

# ── Database ─────────────────────────────────────────────────────────
DATABASE_NAME=landsight
DATABASE_HOST=localhost
DATABASE_PORT=15432
DATABASE_USERNAME=landsight
DATABASE_PASSWORD=landsight
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ── Redis (Celery broker) ───────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=landsight

# ── Celery ───────────────────────────────────────────────────────────
# Prefork processes of the analysis and interpretation workers (`just
# worker-analysis`, `just worker-interpretation`, the docker compose workers).
# Keep the interpretation concurrency equal to the llama-server --parallel slots.
ANALYSIS_WORKER_CONCURRENCY=2
INTERPRETATION_WORKER_CONCURRENCY=2

# ── Authentication ───────────────────────────────────────────────────
AUTH_SECRET_KEY=dev-secret-key-do-not-use-in-production
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_COOKIE_SECURE=false    # Set to true when serving over HTTPS only.

# ── Interpretation LLM ───────────────────────────────────────────────
# OpenAI-compatible llama.cpp server. Local runs reach it through the
# published port; the docker compose stack overrides this via .env.docker.
LLM_BASE_URL=http://localhost:8081/v1
LLM_MODEL=gemma-4-e4b-it
LLM_DEVICE=gpu
LLM_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0.2
# gemma-4-e4b-it is a reasoning model: it spends tokens on chain-of-thought
# (reasoning_content) before producing the visible answer.
LLM_MAX_TOKENS=4096

# ── S3 Storage ────────────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_DEM_BUCKET=landsight-dem
S3_CLIMATE_BUCKET=landsight-climate
S3_ACCESS_KEY=admin
S3_SECRET_KEY=password123
S3_SECURE=false
S3_REGION=us-east-1
