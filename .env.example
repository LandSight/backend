# ── Logging ──────────────────────────────────────────────────────────
LOGGING_LEVEL=INFO
LOGGING_FORMATTER=pretty

# ── Application ──────────────────────────────────────────────────────
APP_HOST=127.0.0.1
APP_PORT=8000
DOCS_HOST=127.0.0.1
DOCS_PORT=8008

# ── Database ─────────────────────────────────────────────────────────
DATABASE_NAME=landsight
DATABASE_HOST=localhost
DATABASE_PORT=15432
DATABASE_USERNAME=landsight
DATABASE_PASSWORD=landsight
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ── Authentication ───────────────────────────────────────────────────
AUTH_SECRET_KEY=dev-secret-key-do-not-use-in-production
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_COOKIE_SECURE=false    # Set to true when serving over HTTPS only.

# ── S3 Storage ────────────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_DEM_BUCKET=landsight-dem
S3_CLIMATE_BUCKET=landsight-climate
S3_ACCESS_KEY=admin
S3_SECRET_KEY=password123
S3_SECURE=false
S3_REGION=us-east-1
